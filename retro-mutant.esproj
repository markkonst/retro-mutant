<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.3653345">
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <BuildCommand>npm run build</BuildCommand>
    <CleanCommand>npm run clean</CleanCommand>
    <ShouldRunNpmInstall>true</ShouldRunNpmInstall>
    <ShouldRunBuildScript>true</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\wwwroot</BuildOutputFolder>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)</IntermediateOutputPath>
  </PropertyGroup>
</Project>
